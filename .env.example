# Copia este archivo como .env y rellena los valores reales.
# El archivo .env nunca se sube al repositorio (está en .gitignore).
#
# Obtén las claves en:
#   Setlist.fm  → https://api.setlist.fm/docs/1.0/
#   Spotify     → https://developer.spotify.com/dashboard

SETLIST_API_KEY=your_setlist_api_key_here
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
