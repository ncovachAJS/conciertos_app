# Copia este archivo como .env y rellena los valores reales.
# El archivo .env nunca se sube al repositorio (está en .gitignore).
#
# Obtén las claves en:
#   Spotify → https://developer.spotify.com/dashboard
#
# Nota: SETLIST_API_KEY ya no hace falta aquí —
# el backend la gestiona directamente.

SPOTIFY_CLIENT_ID=your_spotify_client_id_here

# Jira — Reportar incidencias
# Genera tu API Token en: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_PROJECT_KEY=YOUR_PROJECT_KEY
